{
  "env": {
    "AGENT_BROWSER_HEADED": "1",
    "AGENT_BROWSER_EXECUTABLE_PATH": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "AGENT_BROWSER_PROFILE": "/Users/HAR5HA/.agent-browser/chrome-automation"
  },
  "permissions": {
    "allow": [
      "Bash(agent-browser:*)",
      "mcp__claude-in-chrome__file_upload"
    ],
    "deny": [
      "mcp__gmessages__send_message",
      "mcp__gmessages__send_to_conversation",
      "mcp__gmessages__send_group_message",
      "mcp__gmessages__send_media_to_conversation",
      "mcp__gmessages__react_to_message",
      "mcp__gmessages__import_messages",
      "mcp__gmessages__set_message_transcript",
      "mcp__gmessages__draft_message"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "internal-comms": "off",
    "slack-gif-creator": "off",
    "auto-diagram": "off",
    "pptx": "off",
    "xlsx": "off",
    "doc-coauthoring": "off",
    "algorithmic-art": "off",
    "gsap-core": "off",
    "gsap-timeline": "off",
    "gsap-plugins": "off",
    "gsap-frameworks": "off",
    "gsap-performance": "off",
    "gsap-utils": "off",
    "gsap-react": "off",
    "gsap-scrolltrigger": "off",
    "banner-design": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/git-push-malware-guard.sh",
            "if": "Bash(git push *)",
            "timeout": 30,
            "statusMessage": "Scanning HEAD for malware payloads before push…"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/local-malware-precheck.sh",
            "timeout": 30,
            "statusMessage": "Scanning CWD for malware impostors before npm install/dev…"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/jev-bash-risk-gate.sh",
            "timeout": 5,
            "statusMessage": "jev-gate: judging command risk…"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/mem-guard.sh hook",
            "timeout": 10,
            "statusMessage": "mem-guard: checking RAM before spawning…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/local-malware-postcheck.sh",
            "timeout": 30,
            "statusMessage": "Scanning CWD for malware after git pull/fetch…"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/pr-babysitter-hook.sh",
            "timeout": 45,
            "statusMessage": "Launching PR babysitter (if a PR was just opened)…"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/pr-babysitter-async.sh",
            "timeout": 1500,
            "statusMessage": "Babysitting the new PR (base sync + checks)…",
            "asyncRewake": true,
            "rewakeMessage": "PR babysitter needs you — the PR you just opened has merge conflicts. Resolve them now, before other work:",
            "rewakeSummary": "PR has merge conflicts — needs resolution"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/brain/scripts/session_context.sh",
            "timeout": 15,
            "statusMessage": "Loading Harsha brain context…"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/tcc-clean-claude-residue.sh",
            "timeout": 15,
            "statusMessage": "Checking for stale Claude privacy grants…"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "workflowSizeGuideline": "small",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-custom.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "coderabbit@claude-plugins-official": false,
    "imessage@claude-plugins-official": false,
    "codex@openai-codex": true,
    "stripe@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "jev-compact@jev-compact": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "jev-compact": {
      "source": {
        "source": "directory",
        "path": "/Users/HAR5HA/Desktop/Personal/jev-compact"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "pluginConfigs": {
    "jev-compact@jev-compact": {
      "options": {
        "targetPercent": 45,
        "compactAtPercent": 75,
        "preserveRecentMessages": 12,
        "minReductionRatio": 0.25,
        "brainArchive": true,
        "model": "jev-1.13.0"
      }
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
